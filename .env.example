# OnboardRAG 配置文件
# 复制此文件为 .env 并根据需要修改

# 项目根目录（留空则自动检测）
ONBOARDRAG_ROOT=

# 数据目录
ONBOARDRAG_DATA_DIR=./data

# Milvus Lite 数据库文件路径
MILVUS_DB_PATH=./data/onboard_rag.db

# Embedding 模型
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# Chunk 参数
CHUNK_MIN_SIZE=300
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=80

# 批处理大小（向量化时每次处理的 chunk 数）
EMBEDDING_BATCH_SIZE=32
