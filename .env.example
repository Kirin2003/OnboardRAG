# OnboardRAG 配置文件
# 复制此文件为 .env 并根据需要修改

# 硅基流动 API Key（必填）
# 获取地址: https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=

# 硅基流动 API 地址（一般不需要改）
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Embedding 模型（硅基流动上可用的模型）
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# 项目根目录（留空则自动检测）
ONBOARDRAG_ROOT=

# 数据目录
ONBOARDRAG_DATA_DIR=./data

# Milvus Lite 数据库文件路径
MILVUS_DB_PATH=./data/onboard_rag.db

# Chunk 参数
CHUNK_MIN_SIZE=300
CHUNK_MAX_SIZE=512
CHUNK_OVERLAP=80

# Chunk 切分方法: "section_aware"（自有策略）或 "recursive"（LangChain RecursiveCharacterTextSplitter）
CHUNK_METHOD=recursive

# 批处理大小（向量化时每次请求的 chunk 数）
EMBEDDING_BATCH_SIZE=32

# ──────────────────── 阶段二：LLM 配置 ────────────────────
# LLM API 地址（OpenAI-compatible，阿里百炼示例）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# LLM API Key（如果已设置 OPENAI_API_KEY 环境变量会自动复用）
LLM_API_KEY=sk-your-api-key-here

# LLM 模型名称
LLM_MODEL=qwen3.6-flash-2026-04-16

# ──────────────────── 阶段二：检索参数 ────────────────────
# RRF 合并后返回的最终 chunk 数
RETRIEVAL_TOP_K=10

# Dense 向量检索候选数
DENSE_TOP_K=20

# BM25 关键词检索候选数
BM25_TOP_K=20

# RRF 参数 k 值
RRF_K=60

# ──────────────────── 阶段二：Reranker ────────────────────
# 是否启用 reranker 重排序（true/false，默认 false）
ENABLE_RERANKER=false

# Reranker 模型（仅在 ENABLE_RERANKER=true 时使用）
RERANKER_MODEL=BAAI/bge-reranker-base
