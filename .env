# OnboardRAG 配置文件
# 复制此文件为 .env 并根据需要修改

# 硅基流动 API Key（必填）
# 获取地址: https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=

# 硅基流动 API 地址（一般不需要改）
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Embedding 模型（硅基流动上可用的模型）
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# 项目根目录（留空则自动检测）
ONBOARDRAG_ROOT=

# 数据目录
ONBOARDRAG_DATA_DIR=./data

# Milvus Lite 数据库文件路径
MILVUS_DB_PATH=./data/onboard_rag.db

# Chunk 参数
CHUNK_MIN_SIZE=300
CHUNK_MAX_SIZE=512
CHUNK_OVERLAP=80

# Chunk 切分方法: "section_aware"（自有策略）或 "recursive"（LangChain RecursiveCharacterTextSplitter）
CHUNK_METHOD=recursive

# 批处理大小（向量化时每次请求的 chunk 数）
EMBEDDING_BATCH_SIZE=32
